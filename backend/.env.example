# Copy this file to backend/.env (which Git ignores) and replace the placeholders.
# Real environment variables always take priority over this file.

# DATABASE_URL: the Supabase connection string (Session pooler, port 5432).
# In GitHub Codespaces, set it as a Codespaces secret instead of writing it here.
# For local development only, uncomment the line below and fill in your values.
# Replace every placeholder, and do not leave square brackets in the value.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# CORS_ORIGINS: the frontend addresses allowed to call this API.
# Comma-separated, no spaces needed, and no trailing slash on any address.
# Add your Codespaces address for port 5173 (see the Ports tab) and your local address.
# If your Codespace is recreated, its name changes: update this line and restart the backend.
CORS_ORIGINS=https://YOUR-CODESPACE-NAME-5173.app.github.dev,http://localhost:5173