# Copy this file to backend/.env (which Git ignores) and replace the placeholders.
# Real environment variables always take priority over this file.
# NEVER commit real values. In production set these in Vercel -> Settings -> Environment Variables.

# DATABASE_URL: the Supabase PostgreSQL connection string. Peerora uses the
# existing Supabase project both locally and in production.
# On Vercel use the Transaction pooler (port 6543); locally the Session pooler (5432) also works.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# JWT_SECRET_KEY: signs access tokens. At least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=

# PASSWORD_PEPPER: secret mixed into every password before hashing. At least 16
# characters. Keep a private copy: changing or losing it makes every existing
# password invalid.
# PASSWORD_PEPPER=
# The API refuses to start if either secret is missing or too short. The error
# names the variable but never shows its value.

# Token lifetimes. Access tokens can never exceed 15 minutes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# COOKIE_SECURE: send the refresh cookie only over HTTPS. Use false ONLY for
# local development over http://localhost. Production must be true (the default):
# do NOT copy this line into Vercel; leave COOKIE_SECURE unset there.
COOKIE_SECURE=false

# TRUST_PROXY_HEADERS: read the client IP from X-Forwarded-For. Vercel sets
# VERCEL=1, which enables this automatically; keep false locally.
# TRUST_PROXY_HEADERS=false

# CORS_ORIGINS: the frontend addresses allowed to call this API.
# Comma-separated, no trailing slash. With the Vite proxy (default) and on
# Vercel (same origin) the frontend does not need CORS, but listing the dev
# server is harmless.
CORS_ORIGINS=http://localhost:5173

# ---- Email (password reset) ----
# Without EMAIL_BACKEND, "Forgot password?" tells users that reset by email is
# not available (nothing is pretended to be sent).
#   smtp   - production: any SMTP provider (Gmail app password, Brevo, SendGrid,
#            Mailgun, Amazon SES, ...). Set the SMTP_* values below in Vercel.
#   outbox - LOCAL DEVELOPMENT ONLY: emails are written as .eml files to
#            backend/dev-outbox/ (git-ignored). Refused when running on Vercel.
# EMAIL_BACKEND=outbox
# EMAIL_OUTBOX_DIR=./dev-outbox

# EMAIL_OUTBOX_ALLOW_REMOTE_DB: the outbox is also refused when DATABASE_URL is
# not SQLite, so a local backend pointed at Supabase cannot create real reset
# tokens by accident. Set true ONLY to test password reset against the real
# database on purpose, then delete the .eml files (anyone who can read them can
# reset those accounts). Ignored on Vercel. Never set this in Vercel. Default: false.
# EMAIL_OUTBOX_ALLOW_REMOTE_DB=false

# Public address of the frontend, used to build the reset link. Required in production.
# PUBLIC_APP_URL=https://your-app.vercel.app

# SMTP settings (EMAIL_BACKEND=smtp). SMTP_PASSWORD is a secret: set it only in Vercel / backend/.env.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_SSL=false
# EMAIL_FROM=Peerora <no-reply@your-domain.example>
