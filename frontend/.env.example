# Leave VITE_API_BASE_URL empty (recommended). The app then calls /api on its
# own origin: on Vercel the API is served there, and in development Vite
# forwards /api to the backend (see vite.config.ts).
# Only set it to call a backend on a different origin (no trailing slash,
# no "/api" suffix), e.g. http://localhost:8000
# On Vercel: do NOT define it (an old value ending in /api breaks every call).
# If set, its origin is also added to the Content-Security-Policy connect-src.
VITE_API_BASE_URL=

# Optional: where the Vite dev proxy sends /api (default http://localhost:8000).
# VITE_DEV_API_TARGET=http://localhost:8000
